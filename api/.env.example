# ── Core ──
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omnichannel
REDIS_URL=redis://localhost:6379
# Public base URL of this API (used for OAuth redirect + webhook URLs)
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# 32-byte keys, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me-base64-32-bytes

# Run queue jobs inline instead of via Redis/BullMQ (tests / single-process dev only)
JOBS_INLINE=false
# Order polling interval (backup to webhooks), minutes
ORDER_POLL_MINUTES=10
# Full inventory reconciliation interval, minutes
RECONCILE_MINUTES=60

# ── Shopify (Partner Dashboard → App → Client credentials) ──
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_locations,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders
SHOPIFY_API_VERSION=2026-04

# ── eBay (developer.ebay.com → Application Keys; RuName from User Tokens page) ──
EBAY_ENV=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_NOTIFICATION_VERIFICATION_TOKEN=

# ── Etsy (etsy.com/developers → keystring + shared secret) ──
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_WEBHOOK_SECRET=

# ── Amazon SP-API (Solution Provider Portal; requires developer registration) ──
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_APP_ID=
AMAZON_REGION=eu

# ── Walmart Marketplace (Developer Portal; Solution Provider approval for multi-seller) ──
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=
